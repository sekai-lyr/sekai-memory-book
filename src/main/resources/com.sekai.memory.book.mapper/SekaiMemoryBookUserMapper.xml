<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.sekai.memory.book.mapper.SekaiMemoryBookUserMapper">

    <resultMap id="BaseResultMap" type="com.sekai.memory.book.dataobject.SekaiMemoryBookUserDO">
        <id property="id" column="id"/>
        <result property="userName" column="username"/>
        <result property="password" column="password"/>
        <result property="nickName" column="nickname"/>
        <result property="avatar" column="avatar"/>
        <result property="phoneNumber" column="phone_number"/>
        <result property="membershipPlan" column="membership_plan"/>
        <result property="proExpireTime" column="pro_expire_time"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, username, password, nickname, avatar, phone_number, membership_plan, pro_expire_time, create_time
    </sql>

    <select id="selectByPrimaryKey" parameterType="java.lang.Long" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM sekai_memory_book_user
        WHERE id = #{id}
    </select>

    <select id="selectByUserName" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM sekai_memory_book_user
        WHERE username = #{userName}
    </select>

    <select id="selectByPhoneNumber" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM sekai_memory_book_user
        WHERE phone_number = #{phoneNumber}
        LIMIT 1
    </select>

    <select id="selectByLoginName" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM sekai_memory_book_user
        WHERE username = #{loginName}
           OR nickname = #{loginName}
           OR phone_number = #{loginName}
        ORDER BY CASE WHEN username = #{loginName} THEN 0 ELSE 1 END, id
        LIMIT 1
    </select>

    <delete id="deleteByPrimaryKey" parameterType="java.lang.Long">
        DELETE FROM sekai_memory_book_user
        WHERE id = #{id}
    </delete>

    <insert id="insert"
            parameterType="com.sekai.memory.book.dataobject.SekaiMemoryBookUserDO"
            useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO sekai_memory_book_user (
        username,
        password,
        nickname,
        avatar,
        phone_number
        ) VALUES (
        #{userName},
        #{password},
        #{nickName},
        #{avatar},
        #{phoneNumber}
        )
    </insert>

    <insert id="insertSelective"
            parameterType="com.sekai.memory.book.dataobject.SekaiMemoryBookUserDO"
            useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO sekai_memory_book_user
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userName != null">username,</if>
            <if test="password != null">password,</if>
            <if test="nickName != null">nickname,</if>
            <if test="avatar != null">avatar,</if>
            <if test="phoneNumber != null">phone_number,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="userName != null">#{userName},</if>
            <if test="password != null">#{password},</if>
            <if test="nickName != null">#{nickName},</if>
            <if test="avatar != null">#{avatar},</if>
            <if test="phoneNumber != null">#{phoneNumber},</if>
        </trim>
    </insert>

    <update id="updateByPrimaryKeySelective"
            parameterType="com.sekai.memory.book.dataobject.SekaiMemoryBookUserDO">
        UPDATE sekai_memory_book_user
        <set>
            <if test="userName != null">
                username = #{userName},
            </if>
            <if test="password != null">
                password = #{password},
            </if>
            <if test="nickName != null">
                nickname = #{nickName},
            </if>
            <if test="avatar != null">
                avatar = #{avatar},
            </if>
            <if test="phoneNumber != null">
                phone_number = #{phoneNumber},
            </if>
            <if test="membershipPlan != null">
                membership_plan = #{membershipPlan},
            </if>
            <if test="proExpireTime != null">
                pro_expire_time = #{proExpireTime},
            </if>
        </set>
        WHERE id = #{id}
    </update>

    <update id="updateByPrimaryKey"
            parameterType="com.sekai.memory.book.dataobject.SekaiMemoryBookUserDO">
        UPDATE sekai_memory_book_user
        SET username = #{userName},
        password = #{password},
        nickname = #{nickName},
        avatar = #{avatar},
        phone_number = #{phoneNumber},
        membership_plan = #{membershipPlan},
        pro_expire_time = #{proExpireTime}
        WHERE id = #{id}
    </update>

</mapper>
